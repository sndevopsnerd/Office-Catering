        <script><![CDATA[(function calculateLineTotal(current) {
    var menuItemId = current.getValue('menu_item');
    var quantity = parseInt(current.getValue('quantity'), 10) || 0;

    if (menuItemId) {
        var menuItem = new GlideRecord('x_803913_office_0_menu_item');
        if (menuItem.get(menuItemId)) {
            var price = parseFloat(menuItem.getValue('price')) || 0;
            current.setValue('line_total', (price * quantity).toFixed(2));
        }
    }
})(current);
]]></script>
